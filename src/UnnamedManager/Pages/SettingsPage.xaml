<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UnnamedManager.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:UnnamedManager.UI">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndo" />
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnRedo" />
    </Page.KeyboardAccelerators>

    <!-- Settings looks like Windows Settings: a title, group headers, and one card per setting (S-047).
         Every change is written to the config file at once; Ctrl+Z undoes it. -->
    <ScrollViewer>
        <!-- The Grid centers the column. A ScrollViewer places a child with MaxWidth by its
             desired width, so in a maximized window the column slides off the right edge. -->
        <Grid>
            <StackPanel
                MaxWidth="{StaticResource ContentMaxWidth}"
                Padding="{StaticResource PageMargin}"
                Spacing="{StaticResource SettingsCardSpacing}"
                ui:GridArea.Name="page"
                ui:GridArea.Inset="{StaticResource SpaceXxl}">
                <TextBlock
                    Margin="{StaticResource PageHeaderMargin}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings"
                    ui:GridProbe.Area="page"
                    ui:GridProbe.Name="title" />

                <InfoBar x:Name="Problem" IsClosable="True" Severity="Warning" />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Appearance" ui:GridProbe.Area="page" ui:GridProbe.Name="appearance" />
                <toolkit:SettingsCard Description="The Bindings window, the Guide and the tray menu follow it." Header="App theme">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></toolkit:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ThemeBox" AutomationProperties.Name="App theme" SelectionChanged="OnTheme">
                        <ComboBoxItem Content="Light" Tag="light" />
                        <ComboBoxItem Content="Dark" Tag="dark" />
                        <ComboBoxItem Content="Use system setting" Tag="system" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <TextBlock Margin="{StaticResource SettingsGroupMargin}" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Guide" />
                <toolkit:SettingsCard Description="The panel that lists the keys you can press next. Without it, sequences still run." Header="Show the Guide">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A1;" /></toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="ShowHudToggle" AutomationProperties.Name="Show the Guide" Toggled="OnShowHud" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="How long to pause in a sequence before the Guide shows. A sequence you know runs with nothing on screen." Header="Wait before showing (ms)">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE916;" /></toolkit:SettingsCard.HeaderIcon>
                    <NumberBox Width="{StaticResource SettingsNumberWidth}" x:Name="DelayBox" AutomationProperties.Name="Wait before showing, in milliseconds" LargeChange="500" Maximum="60000" Minimum="0" SmallChange="100" SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" ValueChanged="OnDelay" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="A Guide you forget closes after this long with no key. 0 keeps it open." Header="Close after (ms)">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE823;" /></toolkit:SettingsCard.HeaderIcon>
                    <NumberBox Width="{StaticResource SettingsNumberWidth}" x:Name="TimeoutBox" AutomationProperties.Name="Close after, in milliseconds" LargeChange="1000" Maximum="60000" Minimum="0" SmallChange="500" SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" ValueChanged="OnTimeout" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Where on the screen of the window in front." Header="Position">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE707;" /></toolkit:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="PositionBox" AutomationProperties.Name="Position" SelectionChanged="OnPosition">
                        <ComboBoxItem Content="Center" Tag="center" />
                        <ComboBoxItem Content="Top" Tag="top" />
                        <ComboBoxItem Content="Bottom" Tag="bottom" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <TextBlock Margin="{StaticResource SettingsGroupMargin}" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Keys" />
                <toolkit:SettingsCard Description="Ends a sequence at any step." Header="Cancel key">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE711;" /></toolkit:SettingsCard.HeaderIcon>
                    <Button x:Name="CancelKeyButton" AutomationProperties.Name="Cancel key" Click="OnRecordCancel" LostFocus="OnKeyLostFocus" ToolTipService.ToolTip="Press to record a new cancel key" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Goes up one menu. Turn it off to use the key for bindings." Header="Back key">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72B;" /></toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <Button x:Name="BackKeyButton" AutomationProperties.Name="Back key" Click="OnRecordBack" LostFocus="OnKeyLostFocus" ToolTipService.ToolTip="Press to record a new back key" />
                        <ToggleSwitch x:Name="BackToggle" AutomationProperties.Name="Back key on" Toggled="OnBackToggled" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <TextBlock x:Name="KeyError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

                <TextBlock Margin="{StaticResource SettingsGroupMargin}" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Feedback" />
                <toolkit:SettingsCard Description="Outlines the Guide in your accent color for a moment." Header="Flash on a key that isn't bound">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7B3;" /></toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="FlashToggle" AutomationProperties.Name="Flash on a key that isn't bound" Toggled="OnFlash" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Windows' Default Beep, for a key that isn't bound, an action that can't run, or Focus Window and Swap Window finding no window." Header="Play a sound">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE767;" /></toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="BellToggle" AutomationProperties.Name="Play a sound" Toggled="OnBell" />
                </toolkit:SettingsCard>

                <TextBlock x:Name="WindowsHeader" Margin="{StaticResource SettingsGroupMargin}" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Windows" />
                <toolkit:SettingsCard Description="The space Place Window, Fill and Arrange Windows leave around windows and between them, from 0 to 64 in steps of 2." Header="Gap between windows (epx)">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7C4;" /></toolkit:SettingsCard.HeaderIcon>
                    <NumberBox Width="{StaticResource SettingsNumberWidth}" x:Name="GapBox" AutomationProperties.Name="Gap between windows, in effective pixels" LargeChange="8" Maximum="64" Minimum="0" SmallChange="2" SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" ValueChanged="OnGap" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="The most columns Arrange Windows uses when its action leaves Groups on Automatic." Header="Maximum columns">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xECA5;" /></toolkit:SettingsCard.HeaderIcon>
                    <NumberBox Width="{StaticResource SettingsNumberWidth}" x:Name="ColumnsBox" AutomationProperties.Name="Maximum columns" LargeChange="2" Maximum="8" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" ValueChanged="OnColumns" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="The most rows Arrange Windows uses. All on the display arranges up to columns times rows." Header="Maximum rows">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xECA5;" /></toolkit:SettingsCard.HeaderIcon>
                    <NumberBox Width="{StaticResource SettingsNumberWidth}" x:Name="RowsBox" AutomationProperties.Name="Maximum rows" LargeChange="2" Maximum="8" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" ValueChanged="OnRows" />
                </toolkit:SettingsCard>

                <TextBlock Margin="{StaticResource SettingsGroupMargin}" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Focus and swap" />
                <toolkit:SettingsCard Description="Focus Window and Swap Window skip a window that shows less than a square this size. 0 counts any window with some part showing." Header="Smallest visible part (epx)">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7B3;" /></toolkit:SettingsCard.HeaderIcon>
                    <NumberBox Width="{StaticResource SettingsNumberWidth}" x:Name="MinVisibleBox" AutomationProperties.Name="Smallest visible part, in effective pixels" LargeChange="10" Maximum="200" Minimum="0" SmallChange="2" SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" ValueChanged="OnMinVisible" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Windows whose tops are this close count as one row, for Next window and window numbers." Header="Same row within (epx)">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8FD;" /></toolkit:SettingsCard.HeaderIcon>
                    <NumberBox Width="{StaticResource SettingsNumberWidth}" x:Name="RowToleranceBox" AutomationProperties.Name="Same row within, in effective pixels" LargeChange="10" Maximum="200" Minimum="0" SmallChange="2" SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" ValueChanged="OnRowTolerance" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Windows this close to the same distance count as equally near; the one more in line wins." Header="Equally near within (epx)">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7C2;" /></toolkit:SettingsCard.HeaderIcon>
                    <NumberBox Width="{StaticResource SettingsNumberWidth}" x:Name="TieToleranceBox" AutomationProperties.Name="Equally near within, in effective pixels" LargeChange="10" Maximum="200" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" ValueChanged="OnTieTolerance" />
                </toolkit:SettingsCard>

                <TextBlock Margin="{StaticResource SettingsGroupMargin}" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Apps" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Leave an app's windows out of Focus Window, Swap Window or Arrange Windows. A checked box means the app takes part." TextWrapping="Wrap" />
                <StackPanel x:Name="AppsPanel" Spacing="{StaticResource SettingsCardSpacing}" />
                <toolkit:SettingsCard Description="An app you add starts left out of all three; check the ones it should take part in." Header="Add an app">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE710;" /></toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <Button x:Name="ChooseAppButton" Click="OnChooseApp" Content="Choose app" />
                        <Button x:Name="BrowseAppButton" Click="OnBrowseApp" Content="Browse" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <TextBlock Margin="{StaticResource SettingsGroupMargin}" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Startup" />
                <toolkit:SettingsCard x:Name="StartupCard" Header="Run at startup">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <HyperlinkButton x:Name="StartupAppsLink" Click="OnOpenStartupApps" Content="Open startup apps" Visibility="Collapsed" />
                        <ToggleSwitch x:Name="StartupToggle" AutomationProperties.Name="Run at startup" Toggled="OnStartup" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <TextBlock Margin="{StaticResource SettingsGroupMargin}" Style="{StaticResource BodyStrongTextBlockStyle}" Text="About" />
                <toolkit:SettingsCard x:Name="AboutCard" Header="Unnamed Manager">
                    <toolkit:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/AppIcon.png" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <Button Click="OnOpenConfigFile" Content="Open config file" />
                        <Button Click="OnOpenLogFolder" Content="Open log folder" />
                    </StackPanel>
                </toolkit:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
