<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UnnamedManager.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:UnnamedManager.UI">

    <!-- Settings looks like Windows Settings: a title, group headers, and one card per setting. -->
    <ScrollViewer>
        <!-- The Grid centers the column. A ScrollViewer places a child with MaxWidth by its
             desired width, so in a maximized window the column slides off the right edge. -->
        <Grid>
            <StackPanel
                MaxWidth="{StaticResource ContentMaxWidth}"
                Padding="{StaticResource PageMargin}"
                ui:GridArea.Name="page"
                ui:GridArea.Inset="{StaticResource SpaceXxl}">
                <TextBlock
                    Margin="{StaticResource PageHeaderMargin}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings"
                    ui:GridProbe.Area="page"
                    ui:GridProbe.Name="title" />

                <!-- The app theme is the config's `theme` (S-035); its card comes with the config writer (S-047). -->
                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="About"
                    ui:GridProbe.Area="page"
                    ui:GridProbe.Name="about" />
                <toolkit:SettingsCard x:Name="AboutCard" Header="Unnamed Manager" ui:GridProbe.Area="page" ui:GridProbe.Name="about-card">
                    <toolkit:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/AppIcon.png" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <Button Click="OnOpenConfigFolder" Content="Open file location" />
                </toolkit:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
