<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UnnamedManager.Pages.BindingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:UnnamedManager.Pages"
    xmlns:ui="using:UnnamedManager.UI">

    <!-- Leaders, menus and bindings in a tree on the left, the selected row on the right (S-038). -->
    <Grid Padding="{StaticResource PageMargin}" ui:GridArea.Name="page" ui:GridArea.Inset="{StaticResource SpaceXxl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource BindingsListColumnWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" Margin="{StaticResource PageHeaderMargin}" ui:GridProbe.Area="page" ui:GridProbe.Name="header">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Bindings" />
            <CommandBar x:Name="Commands" Grid.Column="1" DefaultLabelPosition="Right">
                <AppBarButton x:Name="NewBindingButton" Click="OnNewBinding" Label="New binding" ToolTipService.ToolTip="Add a binding to the selected menu (Ctrl+N)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="N" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="NewMenuButton" Click="OnNewMenu" Label="New menu" ToolTipService.ToolTip="Add a menu to the selected menu, or a new leader (Ctrl+Shift+N)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8F4;" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="N" Modifiers="Control,Shift" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="DeleteButton" Click="OnDelete" Label="Delete" ToolTipService.ToolTip="Delete the selected entry and everything under it (Delete)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator x:Name="DeleteKey" Key="Delete" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="DuplicateButton" Click="OnDuplicate" Label="Duplicate" ToolTipService.ToolTip="Copy the selected entry and everything under it, next to it (Ctrl+D)">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" /></AppBarButton.Icon>
                        <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="D" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton x:Name="UndoButton" Click="OnUndo" Label="Undo">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE7A7;" /></AppBarButton.Icon>
                        <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarButton x:Name="RedoButton" Click="OnRedo" Label="Redo">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE7A6;" /></AppBarButton.Icon>
                        <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="Y" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Click="OnReload" Label="Reload config">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                        <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="F5" /></AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarButton Click="OnOpenFile" Label="Open config file">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
                        <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <!-- An invalid file: its errors, while the tree keeps the last valid config. -->
        <InfoBar
            x:Name="Errors"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,0,0,16"
            IsClosable="False"
            Severity="Error"
            ui:GridProbe.Area="page"
            ui:GridProbe.Name="errors"
            Title="The config file has errors">
            <InfoBar.Content>
                <StackPanel x:Name="ErrorList" Margin="0,0,0,16" Spacing="{StaticResource SpaceXs}" />
            </InfoBar.Content>
        </InfoBar>

        <!-- Nothing here yet: what this page is for, and the first action (S-053). -->
        <ui:EmptyState x:Name="Empty" Grid.Row="2" Grid.ColumnSpan="2" Glyph="&#xE765;" Title="No bindings" Line="Add a leader such as Hyper+Space, then the keys under it." ButtonText="New binding" Visibility="Collapsed" />

        <Border x:Name="ListCard" Grid.Row="2" Style="{StaticResource CardStyle}" Padding="{StaticResource ListCardPadding}" ui:GridProbe.Area="page" ui:GridProbe.Name="list">
            <TreeView
                x:Name="Tree"
                AutomationProperties.Name="Bindings"
                AllowDrop="True"
                ContextRequested="OnTreeContextRequested"
                CanDragItems="True"
                CanReorderItems="True"
                DragItemsCompleted="OnDragCompleted"
                SelectionMode="Single"
                SelectionChanged="OnTreeSelectionChanged"
                ItemInvoked="OnItemInvoked">
                <!-- Right-click or Shift+F10 on a row: the same commands, names and shortcuts as the command bar (S-052). -->
                <TreeView.ContextFlyout>
                    <MenuFlyout x:Name="RowMenu" Opening="OnRowMenuOpening">
                        <MenuFlyoutItem Click="OnNewBinding" KeyboardAcceleratorTextOverride="Ctrl+N" Text="New binding">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="OnNewMenu" KeyboardAcceleratorTextOverride="Ctrl+Shift+N" Text="New menu">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="OnKeyField" KeyboardAcceleratorTextOverride="Ctrl+K" Text="Record key">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="OnRenameItem" KeyboardAcceleratorTextOverride="F2" Text="Rename">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="OnDuplicate" KeyboardAcceleratorTextOverride="Ctrl+D" Text="Duplicate">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MoveUpItem" Click="OnMoveUpItem" KeyboardAcceleratorTextOverride="Alt+Up" Text="Move up" />
                        <MenuFlyoutItem x:Name="MoveDownItem" Click="OnMoveDownItem" KeyboardAcceleratorTextOverride="Alt+Down" Text="Move down" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="OnDelete" KeyboardAcceleratorTextOverride="Delete" Text="Delete">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </TreeView.ContextFlyout>
                <TreeView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F2" Invoked="OnRename" />
                    <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnMoveUp" />
                    <KeyboardAccelerator Key="Down" Modifiers="Menu" Invoked="OnMoveDown" />
                </TreeView.KeyboardAccelerators>
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="TreeViewNode">
                        <TreeViewItem AutomationProperties.Name="{x:Bind ((pages:BindingItem)Content).Spoken}">
                            <Grid ColumnSpacing="{StaticResource SpaceMd}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource BindingsKeyMinWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border HorizontalAlignment="Left" Style="{StaticResource KeyCapStyle}">
                                    <TextBlock Style="{StaticResource KeyCapTextStyle}" Text="{x:Bind ((pages:BindingItem)Content).Key}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ((pages:BindingItem)Content).Title}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind ((pages:BindingItem)Content).Title}" />
                                <TextBlock
                                    Grid.Column="2"
                                    MaxWidth="{StaticResource BindingsActionMaxWidth}"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ((pages:BindingItem)Content).Action}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- The selected row's form. -->
        <Border
            x:Name="Detail"
            Grid.Row="2"
            Grid.Column="1"
            Margin="16,0,0,0"
            VerticalAlignment="Top"
            Style="{StaticResource CardStyle}"
            ui:GridArea.Name="detail"
            ui:GridArea.Inset="{StaticResource SpaceLg}">
            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource SpaceSm}">
                <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" ui:GridProbe.Area="detail" ui:GridProbe.Name="title" />
                <TextBlock x:Name="DetailKeys" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Key" />
                <Button x:Name="KeyField" AutomationProperties.Name="Key" Click="OnKeyField" LostFocus="OnKeyFieldLostFocus" ToolTipService.ToolTip="Record the key that picks this entry (Ctrl+K)">
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="K" Modifiers="Control" /></Button.KeyboardAccelerators>
                    <TextBlock x:Name="KeyFieldText" />
                </Button>
                <TextBlock x:Name="KeyHelp" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="KeyError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBox x:Name="TitleBox" Header="Title" KeyDown="OnTitleKeyDown" LostFocus="OnTitleLostFocus" />
                <TextBlock x:Name="TitleError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="Give it a title. The Guide shows it next to the key." TextWrapping="Wrap" Visibility="Collapsed" />
                <ComboBox x:Name="ActionBox" HorizontalAlignment="Stretch" Header="Action" PlaceholderText="Choose an action" SelectionChanged="OnActionChanged" />
                <DropDownButton x:Name="BuiltInButton" AutomationProperties.Name="Built in actions" Content="Built in" ToolTipService.ToolTip="Use an action that needs no setting up, such as Place Window: Left half">
                    <DropDownButton.Flyout><MenuFlyout x:Name="BuiltInMenu" Placement="BottomEdgeAlignedLeft" /></DropDownButton.Flyout>
                </DropDownButton>
                <TextBlock x:Name="DetailAction" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <!-- Spec v18: a held leader works while its modifiers are held, as Alt+Tab does. -->
                <ToggleSwitch x:Name="HoldToggle" Header="Hold to choose" Toggled="OnHoldToggled" />
                <TextBlock x:Name="HoldHelp" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Keep the leader's modifiers held, press its key again to move the highlight, and let go to choose." TextWrapping="Wrap" />
                <!-- Spec v18: a menu holds the keys you add, or a list the app fills. -->
                <ComboBox x:Name="ContentsBox" HorizontalAlignment="Stretch" Header="Contents" SelectionChanged="OnContentsChanged">
                    <x:String>Keys you add</x:String>
                    <x:String>Recent windows</x:String>
                </ComboBox>
                <StackPanel x:Name="ListOptions" Spacing="{StaticResource SpaceSm}">
                    <ComboBox x:Name="ChooseBox" HorizontalAlignment="Stretch" Header="When chosen" SelectionChanged="OnListChanged" ToolTipService.ToolTip="Swap trades places with the window you choose, as Swap Window does">
                        <x:String>Focus the window</x:String>
                        <x:String>Swap with the window</x:String>
                    </ComboBox>
                    <NumberBox x:Name="CountBox" Header="Windows to list" LostFocus="OnListLostFocus" Maximum="99" Minimum="1" SpinButtonPlacementMode="Compact" ValueChanged="OnCountChanged" />
                    <ToggleSwitch x:Name="MinimizedToggle" Header="Minimized windows" Toggled="OnListToggled" />
                    <ComboBox x:Name="DesktopsBox" HorizontalAlignment="Stretch" Header="Desktops" SelectionChanged="OnListChanged">
                        <x:String>Every desktop</x:String>
                        <x:String>This desktop</x:String>
                    </ComboBox>
                    <ComboBox x:Name="ScopeBox" HorizontalAlignment="Stretch" Header="Displays" SelectionChanged="OnListChanged">
                        <x:String>Every display</x:String>
                        <x:String>This display</x:String>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
