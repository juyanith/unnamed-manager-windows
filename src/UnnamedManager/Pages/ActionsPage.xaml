<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UnnamedManager.Pages.ActionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:UnnamedManager.Pages"
    xmlns:ui="using:UnnamedManager.UI">

    <!-- Actions alphabetically on the left, the selected one's form on the right (S-044). -->
    <Grid Padding="{StaticResource PageMargin}" ui:GridArea.Name="page" ui:GridArea.Inset="{StaticResource SpaceXxl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource ListColumnWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" Margin="{StaticResource PageHeaderMargin}" ui:GridProbe.Area="page" ui:GridProbe.Name="header">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" Text="Actions" />
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right">
                <AppBarButton x:Name="NewButton" Click="OnNew" Label="New action" ToolTipService.ToolTip="Add an action that bindings can use (Ctrl+N)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="N" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="DeleteButton" Click="OnDelete" Label="Delete" ToolTipService.ToolTip="Delete the selected action, if no binding uses it (Delete)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator x:Name="DeleteKey" Key="Delete" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="UndoButton" Click="OnUndo" Label="Undo">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE7A7;" /></AppBarButton.Icon>
                        <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarButton x:Name="RedoButton" Click="OnRedo" Label="Redo">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE7A6;" /></AppBarButton.Icon>
                        <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="Y" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <InfoBar
            x:Name="Problem"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,0,0,16"
            IsClosable="True"
            Severity="Warning"
            ui:GridProbe.Area="page"
            ui:GridProbe.Name="problem" />

        <!-- Nothing here yet: what this page is for, and the first action (S-053). -->
        <ui:EmptyState x:Name="Empty" Grid.Row="2" Grid.ColumnSpan="2" Glyph="&#xE945;" Title="No actions" Line="Actions are what bindings do: open an app, run a command, send a shortcut." ButtonText="New action" Visibility="Collapsed" />

        <Border x:Name="ListCard" Grid.Row="2" Style="{StaticResource CardStyle}" Padding="{StaticResource ListCardPadding}" ui:GridProbe.Area="page" ui:GridProbe.Name="list">
            <ListView x:Name="ActionList" AutomationProperties.Name="Actions" SelectionChanged="OnSelectionChanged" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="pages:ActionItem">
                        <StackPanel Padding="0,8,0,8" AutomationProperties.Name="{x:Bind Spoken}">
                            <TextBlock Text="{x:Bind Id}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Detail}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <ScrollViewer Grid.Row="2" Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
            <Border x:Name="DetailCard" VerticalAlignment="Top" Style="{StaticResource CardStyle}" ui:GridArea.Name="detail" ui:GridArea.Inset="{StaticResource SpaceLg}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBox x:Name="IdBox" Header="Id" KeyDown="OnIdKeyDown" LostFocus="OnIdLostFocus" ui:GridProbe.Area="detail" ui:GridProbe.Name="id" />
                    <ComboBox x:Name="TypeBox" HorizontalAlignment="Stretch" Header="Type" SelectionChanged="OnTypeChanged" />
                    <StackPanel x:Name="FieldPanel" Spacing="{StaticResource SpaceMd}" />
                    <StackPanel x:Name="AppButtons" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <Button Click="OnChooseApp" Content="Choose app…" ToolTipService.ToolTip="Pick an app from Start" />
                        <Button Click="OnBrowse" Content="Browse…" ToolTipService.ToolTip="Pick an exe file" />
                    </StackPanel>
                    <TextBlock x:Name="FormError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="UsedBy" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
