<?xml version="1.0" encoding="utf-8"?>
<!-- The Guide's content (S-005, docs/DESIGN.md, The Guide): the path, the rows in
     columns, and the footer. Every color is a theme brush, so light, dark and
     contrast themes all work. GuideWindow puts it on acrylic. -->
<UserControl
    x:Class="UnnamedManager.Guide.GuideView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UnnamedManager.Guide"
    xmlns:ui="using:UnnamedManager.UI">

    <Grid x:Name="Root">
        <!-- With transparency effects off or a contrast theme, the Guide is solid. -->
        <Border x:Name="SolidBackground" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="Collapsed" />

        <StackPanel Padding="{StaticResource GuidePadding}" ui:GridArea.Name="guide" ui:GridArea.Inset="{StaticResource SpaceLg}">
            <!-- S-016: why an action failed, with the warning glyph, never color alone. -->
            <StackPanel x:Name="FailureLine" Orientation="Horizontal" Spacing="{StaticResource SpaceMd}" Visibility="Collapsed">
                <FontIcon VerticalAlignment="Center" Style="{StaticResource WarningGlyphStyle}" />
                <TextBlock
                    x:Name="FailureText"
                    MaxWidth="{StaticResource GuideFailureMaxWidth}"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- The path: menu titles joined with › in secondary text. -->
            <ItemsControl x:Name="PathItems" ui:GridProbe.Area="guide" ui:GridProbe.Name="path">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PathPart">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="{StaticResource GuideTitleMargin}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="›"
                                Visibility="{x:Bind SeparatorVisibility}" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The rows, in up to three columns. -->
            <ItemsControl x:Name="ColumnItems" Margin="{StaticResource GuideSectionMargin}" ui:GridProbe.Area="guide" ui:GridProbe.Name="rows">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GuideColumnSpacing}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:GuideColumn">
                        <ItemsControl ItemsSource="{x:Bind Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:GuideRow">
                                    <Grid>
                                    <!-- Spec v18: the highlighted item of a held menu, filled with the accent. -->
                                    <Border
                                        Margin="{StaticResource GuideHighlightMargin}"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Visibility="{x:Bind HighlightVisibility}" />
                                    <Grid MinHeight="{StaticResource GuideRowMinHeight}" AutomationProperties.Name="{x:Bind Spoken}" Visibility="{x:Bind EntryVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border MinWidth="{x:Bind KeyWidth, Mode=OneWay}" Opacity="{x:Bind KeyOpacity}" Style="{StaticResource KeyCapStyle}">
                                            <TextBlock Style="{StaticResource KeyCapTextStyle}" Text="{x:Bind Key}" />
                                        </Border>
                                        <!-- S-045: the action's glyph, or S-060: the app's, file's or URL's icon;
                                             decorative, so Narrator reads the row as before. -->
                                        <FontIcon
                                            Grid.Column="1"
                                            Width="{StaticResource GuideIconSize}"
                                            Margin="{StaticResource GuideIconMargin}"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{x:Bind Glyph}"
                                            Visibility="{x:Bind GlyphVisibility}" />
                                        <FontIcon
                                            Grid.Column="1"
                                            Width="{StaticResource GuideIconSize}"
                                            Margin="{StaticResource GuideIconMargin}"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Glyph="{x:Bind Glyph}"
                                            Visibility="{x:Bind HighlightedGlyphVisibility}" />
                                        <Image
                                            Grid.Column="1"
                                            Width="{StaticResource GuideIconSize}"
                                            Height="{StaticResource GuideIconSize}"
                                            Margin="{StaticResource GuideIconMargin}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Source="{x:Bind Icon}"
                                            Visibility="{x:Bind ImageVisibility}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            MaxWidth="{StaticResource GuideTitleMaxWidth}"
                                            Margin="{StaticResource GuideTitleMargin}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            Visibility="{x:Bind AvailableVisibility}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            MaxWidth="{StaticResource GuideTitleMaxWidth}"
                                            Margin="{StaticResource GuideTitleMargin}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            Visibility="{x:Bind HighlightedTitleVisibility}" />
                                        <!-- S-014: nothing to run for the app in front, dimmed, with words. -->
                                        <StackPanel
                                            Grid.Column="2"
                                            Margin="{StaticResource GuideTitleMargin}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="{StaticResource SpaceSm}"
                                            Visibility="{x:Bind UnavailableVisibility}">
                                            <TextBlock
                                                MaxWidth="{StaticResource GuideTitleMaxWidth}"
                                                Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind UnavailableNote}" />
                                        </StackPanel>
                                        <!-- Spec v18: where a list's window is, such as minimized. -->
                                        <Grid Grid.Column="3" Margin="{StaticResource GuideTitleMargin}" VerticalAlignment="Center" Visibility="{x:Bind NoteVisibility}">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Note}" Visibility="{x:Bind PlainVisibility}" />
                                            <TextBlock Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Note}" Visibility="{x:Bind HighlightVisibility}" />
                                        </Grid>
                                        <FontIcon
                                            Grid.Column="4"
                                            FontSize="{StaticResource GuideChevronSize}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE76C;"
                                            Visibility="{x:Bind ChevronVisibility}" />
                                    </Grid>
                                    <!-- Home (S-021): a group's header, and the line under the current group. -->
                                    <TextBlock
                                        Margin="{StaticResource GuideSectionMargin}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Title}"
                                        Visibility="{x:Bind HeaderVisibility}" />
                                    <Border
                                        Margin="{StaticResource GuideSectionMargin}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="{StaticResource GuideDividerThickness}"
                                        Visibility="{x:Bind SeparatorVisibility}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The footer: Cancel and Back, in secondary text, below a divider. -->
            <Border
                x:Name="Footer"
                Margin="{StaticResource GuideSectionMargin}"
                Padding="{StaticResource GuideSectionMargin}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="{StaticResource GuideDividerThickness}"
                ui:GridProbe.Area="guide"
                ui:GridProbe.Name="footer">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXl}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <Border Style="{StaticResource KeyCapStyle}">
                            <TextBlock x:Name="CancelKey" Style="{StaticResource KeyCapCaptionTextStyle}" Text="Esc" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Cancel" />
                    </StackPanel>
                    <!-- Spec v18: a held menu chooses on letting go. -->
                    <TextBlock
                        x:Name="HoldHint"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Let go to choose"
                        Visibility="Collapsed" />
                    <StackPanel x:Name="BackHint" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <Border Style="{StaticResource KeyCapStyle}">
                            <TextBlock x:Name="BackKey" Style="{StaticResource KeyCapCaptionTextStyle}" Text="Backspace" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Back" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- S-033: the flash for a key that isn't bound, the Guide's one use of the accent. -->
        <Border
            x:Name="FlashOutline"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            Margin="{StaticResource GuideFlashMargin}"
            BorderThickness="{StaticResource GuideFlashThickness}"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
