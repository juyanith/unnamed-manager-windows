<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UnnamedManager.UI.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- An empty page (S-053): a glyph, a title, one line on what to do, and the first action. -->
    <StackPanel MaxWidth="{StaticResource EmptyStateMaxWidth}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource SpaceSm}">
        <FontIcon x:Name="Icon" HorizontalAlignment="Center" FontSize="{StaticResource EmptyStateGlyphSize}" />
        <TextBlock x:Name="TitleText" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock x:Name="LineText" HorizontalAlignment="Center" Style="{StaticResource FieldDescriptionTextStyle}" TextAlignment="Center" />
        <Button x:Name="Action" Margin="{StaticResource EmptyStateButtonMargin}" HorizontalAlignment="Center" Click="OnClick" Style="{StaticResource AccentButtonStyle}" />
    </StackPanel>
</UserControl>
