<!--
  Named styles for parts WinUI doesn't have. Colors come from theme brushes only, so light,
  dark and contrast themes all work. Rules: design/DESIGN-SYSTEM.md, Styles.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A card on the Mica layer: the list and detail cards of the Bindings window. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="BorderThickness" Value="{StaticResource CardBorderThickness}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!-- A key in the Guide, the Help page and the key recorder: like the keys in Windows' own shortcut hints. -->
    <Style x:Key="KeyCapStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="{StaticResource KeyCapMinWidth}" />
        <Setter Property="MinHeight" Value="{StaticResource KeyCapMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource KeyCapPadding}" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="{StaticResource KeyCapBorderThickness}" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The key name inside a keycap. -->
    <Style x:Key="KeyCapTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The smaller key name in the Guide's footer (Esc Cancel, Backspace Back). -->
    <Style x:Key="KeyCapCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- The warning glyph (E7BA) beside a config error or a failed action, always with words. -->
    <Style x:Key="WarningGlyphStyle" TargetType="FontIcon">
        <Setter Property="Glyph" Value="&#xE7BA;" />
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
</ResourceDictionary>
