<!--
  Sizes WinUI has no resource for: the Guide, and the Bindings window's columns.
  Spacing stays in Space.xaml. Rules for each: design/DESIGN-SYSTEM.md, Layout.xaml.
  tools/grid-lint.ps1 skips this file.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The Bindings page needs room for key, title and action; Actions and Contexts use ListColumnWidth (320). -->
    <GridLength x:Key="BindingsListColumnWidth">360</GridLength>
    <!-- The action id at the end of a Bindings row; a longer one trims. -->
    <x:Double x:Key="BindingsActionMaxWidth">120</x:Double>
    <!-- Room for a one-letter keycap, so titles under one menu line up. -->
    <x:Double x:Key="BindingsKeyMinWidth">32</x:Double>
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <!-- A list card: rows run close to its edge, as in Windows Settings. -->
    <Thickness x:Key="ListCardPadding">4</Thickness>
    <!-- Settings: 4 epx between cards, as in Windows Settings; a group header sits 32 above and 8 above its first card. -->
    <x:Double x:Key="SettingsCardSpacing">4</x:Double>
    <x:Double x:Key="SettingsNumberWidth">120</x:Double>
    <Thickness x:Key="SettingsGroupMargin">0,28,0,4</Thickness>
    <!-- The version line under Help's links, lined up with the link text. -->
    <Thickness x:Key="HelpVersionMargin">12,0,0,0</Thickness>
    <!-- An empty page's text column, and the space above its button. -->
    <x:Double x:Key="EmptyStateMaxWidth">400</x:Double>
    <Thickness x:Key="EmptyStateButtonMargin">0,8,0,0</Thickness>
    <!-- An app's icon in a context's list. -->
    <x:Double x:Key="ContextIconSize">20</x:Double>
    <!-- Choose app: the dialog's content and its list. -->
    <x:Double x:Key="AppPickerWidth">420</x:Double>
    <x:Double x:Key="AppPickerListHeight">360</x:Double>
    <!-- The Help page's single column. -->
    <x:Double x:Key="HelpMaxWidth">640</x:Double>

    <!-- The Guide (docs/DESIGN.md, The Guide). -->
    <Thickness x:Key="GuidePadding">16</Thickness>
    <x:Double x:Key="GuideRowMinHeight">32</x:Double>
    <x:Double x:Key="GuideIconSize">24</x:Double>
    <!-- 12 epx from the keycap; the title keeps its own 12 epx after the icon. -->
    <Thickness x:Key="GuideIconMargin">12,0,0,0</Thickness>
    <x:Double x:Key="GuideColumnSpacing">24</x:Double>
    <!-- The chevron after a menu's title, and the divider above the footer. -->
    <x:Double x:Key="GuideChevronSize">12</x:Double>
    <Thickness x:Key="GuideDividerThickness">0,1,0,0</Thickness>
    <!-- 8 epx between the path and the rows, and above and below the footer's divider. -->
    <Thickness x:Key="GuideSectionMargin">0,8,0,0</Thickness>
    <!-- A title longer than this trims with an ellipsis; Narrator reads it whole. -->
    <x:Double x:Key="GuideTitleMaxWidth">320</x:Double>
    <!-- A failed action's message wraps at this width (S-016). -->
    <x:Double x:Key="GuideFailureMaxWidth">420</x:Double>
    <!-- Space between a keycap and its title, and before a menu's chevron. -->
    <Thickness x:Key="GuideTitleMargin">12,0,12,0</Thickness>
    <!-- Top and Bottom positions sit this far from the work area's edge. -->
    <x:Double x:Key="GuideEdgeOffset">48</x:Double>
    <!-- The flash outline for a key that isn't bound. -->
    <Thickness x:Key="GuideFlashThickness">2</Thickness>
    <!-- The window's 1 px top frame covers the client area's first row: start the outline under it. -->
    <Thickness x:Key="GuideFlashMargin">0,1,0,0</Thickness>

    <!-- Keycaps: at least square, so a column of single keys lines up. -->
    <x:Double x:Key="KeyCapMinHeight">24</x:Double>
    <x:Double x:Key="KeyCapMinWidth">24</x:Double>
    <Thickness x:Key="KeyCapPadding">8,0,8,0</Thickness>
    <Thickness x:Key="KeyCapBorderThickness">1</Thickness>
</ResourceDictionary>
