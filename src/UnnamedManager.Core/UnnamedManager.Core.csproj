<Project Sdk="Microsoft.NET.Sdk">
  <!-- Rules and data logic with no WinUI, so tests run without the app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UnnamedManager.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared spec's schema, written next to the config (S-002). -->
    <EmbeddedResource Include="..\..\spec\config.schema.json" LogicalName="config.schema.json" />
  </ItemGroup>
</Project>
