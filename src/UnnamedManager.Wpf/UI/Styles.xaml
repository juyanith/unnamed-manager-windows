<!--
  The Guide's sizes and styles, the same values as the WinUI app's UI/Layout.xaml, UI/Space.xaml
  and UI/Styles.xaml. Colors are the Fluent theme's brushes (Application.ThemeMode), always
  through DynamicResource, so they follow light and dark.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Double x:Key="SpaceXs">4</sys:Double>
    <sys:Double x:Key="SpaceSm">8</sys:Double>
    <sys:Double x:Key="SpaceMd">12</sys:Double>
    <sys:Double x:Key="SpaceLg">16</sys:Double>
    <sys:Double x:Key="SpaceXl">24</sys:Double>

    <!-- The Guide (docs/DESIGN.md, The Guide). -->
    <Thickness x:Key="GuidePadding">16</Thickness>
    <sys:Double x:Key="GuideRowMinHeight">32</sys:Double>
    <sys:Double x:Key="GuideIconSize">24</sys:Double>
    <Thickness x:Key="GuideIconMargin">12,0,0,0</Thickness>
    <!-- WPF's StackPanel has no Spacing: each column after the first gets this left margin. -->
    <Thickness x:Key="GuideColumnMargin">24,0,0,0</Thickness>
    <sys:Double x:Key="GuideChevronSize">12</sys:Double>
    <Thickness x:Key="GuideDividerThickness">0,1,0,0</Thickness>
    <Thickness x:Key="GuideSectionMargin">0,8,0,0</Thickness>
    <sys:Double x:Key="GuideTitleMaxWidth">320</sys:Double>
    <sys:Double x:Key="GuideFailureMaxWidth">420</sys:Double>
    <Thickness x:Key="GuideTitleMargin">12,0,12,0</Thickness>
    <Thickness x:Key="GuideHighlightMargin">-4,0,-4,0</Thickness>
    <sys:Double x:Key="GuideEdgeOffset">48</sys:Double>
    <Thickness x:Key="GuideFlashThickness">2</Thickness>
    <CornerRadius x:Key="GuideCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="KeyCapCornerRadius">4</CornerRadius>

    <!-- Keycaps: at least square, so a column of single keys lines up. -->
    <sys:Double x:Key="KeyCapMinHeight">24</sys:Double>
    <sys:Double x:Key="KeyCapMinWidth">24</sys:Double>
    <Thickness x:Key="KeyCapPadding">8,0,8,0</Thickness>
    <Thickness x:Key="KeyCapBorderThickness">1</Thickness>

    <!-- Segoe UI Variable's type ramp, as WinUI's Body, Body Strong and Caption. -->
    <FontFamily x:Key="TextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="GlyphFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="GlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlyphFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- A row's glyph in the Guide's 24 epx icon space: 20, as WinUI's FontIcon draws it. -->
    <Style x:Key="GuideRowGlyphStyle" TargetType="TextBlock" BasedOn="{StaticResource GlyphStyle}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- A key in the Guide: like the keys in Windows' own shortcut hints. -->
    <Style x:Key="KeyCapStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="{StaticResource KeyCapMinWidth}" />
        <Setter Property="MinHeight" Value="{StaticResource KeyCapMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource KeyCapPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource KeyCapCornerRadius}" />
        <Setter Property="BorderThickness" Value="{StaticResource KeyCapBorderThickness}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KeyCapTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KeyCapCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SecondaryCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
</ResourceDictionary>
