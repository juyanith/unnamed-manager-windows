<!-- The app's two keycaps in one color (S-094), as the WinUI app's Guide/AppMark.xaml. -->
<UserControl
    x:Class="UnnamedManager.Guide.AppMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False">

    <Viewbox Width="{StaticResource GuideMarkSize}" Height="{StaticResource GuideMarkSize}">
        <Grid Width="{StaticResource GuideIconSize}" Height="{StaticResource GuideIconSize}">
            <Path
                Data="M16 5 A3 3 0 0 0 13 2 H5 A3 3 0 0 0 2 5 V13 A3 3 0 0 0 5 16"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                StrokeThickness="2" />
            <Path
                Data="F0 M10 7 H20 A3 3 0 0 1 23 10 V20 A3 3 0 0 1 20 23 H10 A3 3 0 0 1 7 20 V10 A3 3 0 0 1 10 7 Z M12 10 L15 10 L20 15 L15 20 L12 20 L17 15 Z"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
    </Viewbox>
</UserControl>
